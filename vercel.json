{
    "version": 2,
    "builds": [
        {
            "src": "Website/api/chat.js",
            "use": "@vercel/node"
        },
        {
            "src": "Website/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/chat",
            "dest": "/Website/api/chat.js"
        },
        {
            "src": "/",
            "dest": "/Website/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/Website/$1"
        }
    ]
}